# Primary PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/calcom

# Direct PostgreSQL connection string for migrations bypassing connection poolers
DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/calcom

# Base public URL for the web application
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3000

# Secret key used to encrypt NextAuth session tokens
NEXTAUTH_SECRET=placeholder_secret_key_at_least_32_chars

# Canonical URL for NextAuth authentication callbacks
NEXTAUTH_URL=http://localhost:3000

# Symmetric encryption key for securing credentials and third-party tokens
CALENDSO_ENCRYPTION_KEY=placeholder_encryption_key_at_least_32_chars

# API key protecting scheduled internal cron endpoints
CRON_API_KEY=placeholder_cron_api_key

# Step interval in minutes for slot slicing and calendar display
NEXT_PUBLIC_AVAILABILITY_SCHEDULE_INTERVAL=15

# Toggle flag enabling Cloudflare Turnstile bot verification on booking page
NEXT_PUBLIC_CLOUDFLARE_USE_TURNSTILE_IN_BOOKER=false

# Redis connection URL for caching and rate limiting
REDIS_URL=redis://localhost:6379
